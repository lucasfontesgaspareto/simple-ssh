{
  "name": "simple-ssh",
  "version": "0.2.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node mobaimport.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "productName": "Simple SSH",
  "build": {
    "appId": "com.lucasfontesgaspareto.simple-ssh",
    "artifactName": "Simple-SSH-Setup-${version}.exe",
    "files": [
      "*.js",
      "index.html"
    ],
    "win": {
      "target": "nsis"
    },
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}
